{
  "id": "stellamem-adapter",
  "name": "Stellamem Adapter",
  "description": "Local, task-scoped approved claim projection.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "coreDir": {
        "type": "string"
      },
      "maxInjectChars": {
        "type": "number",
        "minimum": 0,
        "maximum": 16000,
        "description": "Total injected context budget."
      },
      "activeScopes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Explicit task scopes; global is always eligible."
      }
    }
  }
}
